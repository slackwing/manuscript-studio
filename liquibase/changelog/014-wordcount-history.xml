<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- Daily wordcount history (optional feature — wordcount_history in
         config.yaml). One row per manuscript per day, overwritten in place
         by the hourly in-process cron, so the table grows by exactly one
         row/manuscript/day while today's number stays at most an hour old.
         Aggregated across ALL users:
           words_committed — latest done migration's prose words
           words_effective — committed with pending suggestions substituted
           words_snippets  — linked, not-yet-canonized scratchpad snippets
         (a canonized snippet lives in the book as a suggestion, so it is
         counted by words_effective and excluded here — never both). -->
    <changeSet id="014-wordcount-history" author="claude">
        <createTable tableName="wordcount_history">
            <column name="manuscript_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_wordcount_history_manuscript"
                             references="manuscript(manuscript_id)"/>
            </column>
            <column name="day" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="words_committed" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="words_effective" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="words_snippets" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="computed_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="wordcount_history"
                       columnNames="manuscript_id, day"
                       constraintName="pk_wordcount_history"/>
    </changeSet>

</databaseChangeLog>

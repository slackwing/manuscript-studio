<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- Permissions v3 + multi-user layers (PERMISSIONS_PLAN.md).

         role         - (username, manuscript_id, role) grants; a user may
                        hold several roles on one manuscript. Role → action
                        bundles live in the embedded roles.json, not here.
                        Any row makes the manuscript visible; this replaces
                        manuscript_access as the read path (the old table
                        stays on disk, unread, as a safety net).
         suggested_change - review workflow (accepted/rejected by whom,
                        when) + staleness (carried across a migration onto
                        a sentence whose text changed).
         note_hide    - per-viewer, reversible, owner-invisible hide.
         people_order - per-viewer drag order of the People tab; doubles
                        as the suggestion-display priority. -->
    <changeSet id="038-roles-multiuser" author="claude">
        <createTable tableName="role">
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_role_user"
                             references="user(username)"/>
            </column>
            <column name="manuscript_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_role_manuscript"
                             references="manuscript(manuscript_id)"/>
            </column>
            <column name="role" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="role" columnNames="username, manuscript_id, role"
                       constraintName="pk_role"/>

        <!-- Cutover data migration: every legacy access grant becomes the
             full pre-v3 power set (admin+author+editor+pointer) so nothing
             the single-user era could do is lost. Grants whose manuscript
             name has no row yet (never reconciled) are skipped — startup
             reconciliation creates the row and the operator can re-grant. -->
        <sql>
            INSERT INTO role (username, manuscript_id, role)
            SELECT ma.username, m.manuscript_id, r.role
            FROM manuscript_access ma
            JOIN manuscript m ON m.name = ma.manuscript_name
            CROSS JOIN (VALUES ('admin'), ('author'), ('editor'), ('pointer')) AS r(role)
            ON CONFLICT DO NOTHING;
        </sql>

        <addColumn tableName="suggested_change">
            <column name="review_status" type="VARCHAR(10)"/>
            <column name="reviewed_by" type="VARCHAR(255)"/>
            <column name="reviewed_at" type="TIMESTAMPTZ"/>
            <column name="stale" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createTable tableName="note_hide">
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_note_hide_user"
                             references="user(username)"/>
            </column>
            <column name="note_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_note_hide_note"
                             references="note(note_id)"
                             deleteCascade="true"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="note_hide" columnNames="username, note_id"
                       constraintName="pk_note_hide"/>

        <createTable tableName="people_order">
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_people_order_user"
                             references="user(username)"/>
            </column>
            <column name="manuscript_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_people_order_manuscript"
                             references="manuscript(manuscript_id)"/>
            </column>
            <column name="ordering" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="people_order" columnNames="username, manuscript_id"
                       constraintName="pk_people_order"/>
    </changeSet>

</databaseChangeLog>
